{
  "name": "equs-sdk-demo-nodejs",
  "private": true,
  "version": "0.1.0",
  "description": "Node.js demo for EQUS SDK",
  "main": "",
  "config": {
    "nodejs_equs_sdk_wrapper_path": "--prefix=../../../wrappers/nodejs",
    "askar_storage_wrapper_path": "--prefix=../../../plugins/askar/wrappers/nodejs"
  },
  "scripts": {
    "build": "rm -rf build && tsc",
    "issuer": "node build/applications/issuer.js",
    "verifier": "node build/applications/verifier.js",
    "holder": "node build/applications/holder.js",
    "prepare_nodejs_equs_sdk_wrapper": "npm i $npm_package_config_nodejs_equs_sdk_wrapper_path && npm run build:debug $npm_package_config_nodejs_equs_sdk_wrapper_path",
    "prepare_askar_storage_wrapper": "npm i $npm_package_config_askar_storage_wrapper_path && npm run build $npm_package_config_askar_storage_wrapper_path",
    "preinstall": "npm run prepare_nodejs_equs_sdk_wrapper && npm run prepare_askar_storage_wrapper"
  },
  "author": "aziz.mukhtorjonov@dsr-corporation.com",
  "dependencies": {
    "@equs/equs-sdk": "../../../wrappers/nodejs",
    "@equs/equs-sdk-askar-storage": "../../../plugins/askar/wrappers/nodejs",
    "body-parser": "^2.0.1",
    "cors": "^2.8.5",
    "express": "^5.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.4.3"
  }
}
