@startuml
'https://plantuml.com/component-diagram
left to right direction

package "Applications" as App #LightBlue  {
   [KMS Impl] as KMSApp
   [Vault Impl] as VaultApp
   [App Logic] as AppL
}

package "ASDK" as ASDK {

     package "Pluggable" #LightGray {
         [KMS Interface] as KMS #Green
         [Vault Interface] as Vault #Green
     }

    package "Public API" as API #LightGray {
         package "VC Exchange" as VC1 {
            [OID4VC] as VCOID #Green
            [Aries] as Aries #Orange
         }
         [DIDComm Protocols] as DIDCommP #Orange

         [DID] as DID #Green
    }

    package "Internal" as Int #Gray {

        [VC Core] as VCCore #Green
        [VC Formats] as VCF #Green
        VCCore --> VCF

        [DIDComm] as DIDComm #Orange
        [Utils] #Green
    }

}

'API ---> Int
VCOID ---> VCCore
Aries ---> VCCore
DIDCommP ---> DIDComm

VaultApp --|> Vault
KMSApp --|> KMS
AppL --> API

note left of ASDK: Green - already implemented;\nOrange - later versions


@enduml