@startuml
' NOTE: docs/equs-sdk.png is NOT generated from this file. The committed PNG is the
' original hand-drawn diagram, with only the "BCI Agency" label patched to "Equs
' Agency"; its layout is deliberately preserved. This file is a reconstruction of
' the same content in PlantUML — same actors, packages and relationships, different
' layout, since PlantUML places nodes itself. Re-rendering it will NOT reproduce the
' committed image.
'https://plantuml.com/component-diagram

skinparam linetype ortho
skinparam nodesep 12
skinparam ranksep 24

actor "Application\n(e.g. Equs Agency)" as App
actor "3rd party" as ThirdParty
database "Persistent data\nto be managed by the app" as Store
queue "Message Queue" as MQ

package "SDK" as SDK {

    package "VC Impls" as VCImpls {
        [W3C SD-JWT] as SDJWT
        [mDL 1803-5] as MDL18035
        [JWT] as JWT
        [JSON-LD] as JSONLD
        [CL AnonCreds] as AnonCreds
        [KERI ACDC] as ACDC
        SDJWT -[hidden]right- MDL18035
        MDL18035 -[hidden]right- JWT
        JWT -[hidden]right- JSONLD
        JSONLD -[hidden]right- AnonCreds
        AnonCreds -[hidden]right- ACDC
    }

    [mDL 23220-3] as MDL232203
    [DIDComm\nAries] as DIDCommAries
    [OIDC4VC/VP] as OIDC4VC
    [W3C VC API] as W3CVCAPI
    [KERI OOBI/\nIPEX] as KERIOOBI

    MDL232203 -[hidden]down- DIDCommAries
    DIDCommAries -[hidden]down- OIDC4VC
    OIDC4VC -[hidden]down- W3CVCAPI
    W3CVCAPI -[hidden]down- KERIOOBI

    package "Core" as Core {

        package "VC" as VC {
            [VC\nExchange] as VCExchange
            [VC Format] as VCFormat
            [VC\nConverter] as VCConverter
            VCExchange -[hidden]right- VCFormat
            VCFormat -[hidden]right- VCConverter
        }

        [Credentials\nstorage] as CredStorage
        [KMS] as KMS
        [Protocol\nEngine] as PE
        [DID Core] as DIDCore

        CredStorage -[hidden]down- KMS
        PE -[hidden]right- DIDCore
    }

    package "DID Resolvers" as DIDResolvers {
        [did:indy] as DidIndy
        [did:peer] as DidPeer
        [did:web] as DidWeb
        [did:key] as DidKey
        [did:keri] as DidKeri
        [did:tdw] as DidTdw
        [did:ion] as DidIon
        DidIndy -[hidden]right- DidPeer
        DidPeer -[hidden]right- DidWeb
        DidWeb -[hidden]right- DidKey
        DidIndy -[hidden]down- DidKeri
        DidKeri -[hidden]right- DidTdw
        DidTdw -[hidden]right- DidIon
    }
}

[Aries Askar] as Askar
[IOTA Stronghold] as Stronghold
[Default KMS impl] as DefaultKMS
[HSM Adapter] as HSM

Askar -[hidden]down- Stronghold
Stronghold -[hidden]down- DefaultKMS
DefaultKMS -[hidden]down- HSM

' application-facing usage
App -right-> VCExchange : Direct Usage of VC API\nfor OIDC-like flows
App -right-> PE : Usage of Protocol Engine\nfor DIDComm-like flows
App -down-> Store
PE -left-> MQ : outgoing DIDComm
MQ -up-> ThirdParty
ThirdParty -up-> App

' protocol adapters realise the core interfaces
MDL232203 ..|> VCExchange
DIDCommAries ..|> VCExchange
DIDCommAries ..|> PE
OIDC4VC ..|> VCExchange
W3CVCAPI ..|> VCExchange
KERIOOBI ..|> PE

' credential formats realise VC Format
VCImpls ..|> VCFormat

' pluggable back-ends supplied by the integrator
Askar ..|> CredStorage
Askar ..|> KMS
Stronghold ..|> KMS
DefaultKMS ..|> KMS
HSM ..|> KMS

' resolvers realise DID Core
DIDResolvers ..|> DIDCore

' internal wiring
VCConverter --> CredStorage
VCFormat --> DIDCore
PE --> DIDCore
DIDCore --> KMS

@enduml
