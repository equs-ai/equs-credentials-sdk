@startuml
' docs/equs-sdk.png IS generated from this file:
'   plantuml -tpng docs/equs-sdk.puml
' It previously was not — the committed PNG was hand-drawn art whose layout was preserved by
' hand. That original showed a roadmap rather than the implementation (AnonCreds, KERI, ISO
' 23220-3, W3C VC API, Stronghold, an HSM adapter, did:indy/keri/tdw/ion — none of which exist
' in the tree), so it was replaced with a render of this source. Layout is PlantUML's; content
' is what the SDK actually implements.
'https://plantuml.com/component-diagram

skinparam linetype ortho
' nodesep 35 (not the default 12) keeps the App->PE edge clear of the SDK package tab.
skinparam nodesep 35
skinparam ranksep 24

' Wrapped onto three lines so the caption box stays narrow enough that the edge leaving
' this actor does not run through the text.
actor "Application\n(e.g.\nEqus Agency)" as App
actor "3rd party" as ThirdParty
database "Persistent data\nto be managed by the app" as Store
queue "Message Queue" as MQ

package "SDK" as SDK {

    package "VC Formats" as VCImpls {
        [SD-JWT VC] as SDJWT
        [W3C VC\nJSON-LD] as JSONLD
        [mDL ISO 18013-5\n(verification only)] as MDL18013
        SDJWT -[hidden]right- JSONLD
        JSONLD -[hidden]right- MDL18013
    }

    package "VC Exchange Protocols" as Protocols {
        [DIDComm\nAries] as DIDCommAries
        [OID4VCI/\nOID4VP] as OIDC4VC
        DIDCommAries -[hidden]right- OIDC4VC
    }

    package "Core" as Core {

        ' These two were grouped in an inner "VC" package. Its title tab sat directly under the
        ' VCImpls ..|> VCFormat edge, which drew straight through the text, so the grouping box
        ' was dropped; both components still read as VC-specific and stay adjacent inside Core.
        [VC\nExchange] as VCExchange
        [VC Format] as VCFormat
        VCExchange -[hidden]right- VCFormat

        [Credentials\nstorage] as CredStorage
        [KMS] as KMS
        [Protocol\nEngine] as PE
        [DID Core] as DIDCore

        CredStorage -[hidden]down- KMS
        PE -[hidden]right- DIDCore
    }

    package "DID Resolvers" as DIDResolvers {
        [did:key] as DidKey
        [did:web] as DidWeb
        [did:peer] as DidPeer
        [did:ethr] as DidEthr
        [did:webvh] as DidWebvh
        DidKey -[hidden]right- DidWeb
        DidWeb -[hidden]right- DidPeer
        DidKey -[hidden]down- DidEthr
        DidEthr -[hidden]right- DidWebvh
    }
}

package "Integrator-supplied back-ends" as Backends {
    [Aries Askar\n(plugin)] as Askar
    [In-Memory\nKMS / Vault / Storage\n(tests & demos)] as InMem
    Askar -[hidden]down- InMem
}

' application-facing usage
App -right-> VCExchange : VC API\n(OID4VC flows)
' <back:white> masks the vertical lines this label would otherwise be printed on top of.
App -right-> PE : <back:white>Protocol Engine API</back>\n<back:white>(DIDComm flows)</back>
App -down-> Store
PE -left-> MQ : outgoing DIDComm
MQ -up-> ThirdParty
ThirdParty -up-> App

' protocol adapters realise the core interfaces
DIDCommAries ..|> VCExchange
DIDCommAries ..|> PE
OIDC4VC ..|> VCExchange

' credential formats realise VC Format
VCImpls ..|> VCFormat

' pluggable back-ends supplied by the integrator
Askar ..|> CredStorage
Askar ..|> KMS
InMem ..|> CredStorage
InMem ..|> KMS

' resolvers realise DID Core
DIDResolvers ..|> DIDCore

' Keep the resolver package below Core. Without this, graphviz places it to Core's left, in the
' same horizontal band as the App->PE and PE->MQ edges, and their labels land on top of the
' "DID Resolvers" package title.
DIDCore -[hidden]down- DidKey

' internal wiring
VCFormat --> CredStorage
VCFormat --> DIDCore
PE --> DIDCore
DIDCore --> KMS

@enduml
