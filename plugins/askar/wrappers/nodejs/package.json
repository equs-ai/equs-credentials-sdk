{
  "name": "@equstng/agent-sdk-askar-storage",
  "version": "1.3.0",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "agent-sdk-askar-storage",
    "triples": {
      "additional": [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "x86_64-unknown-linux-gnu"
      ]
    }
  },
  "ava": {
    "timeout": "3m"
  },
  "engines": {
    "node": ">= 10"
  },
  "scripts": {
    "manual_scripts": "node scripts/add-import-line.mjs",
    "build": "CARGO_TARGET_DIR=../../target napi build --platform --release --js binary.js --dts binary.d.ts && npm run manual_scripts && rm -rf build/ && tsc",
    "artifacts": "napi artifacts",
    "test": "jest -w=1",
    "universal": "napi universal",
    "version": "napi version",
    "postinstall": "npm i --ignore-scripts"
  },
  "packageManager": "yarn@4.6.0",
  "dependencies": {
    "@napi-rs/cli": "^2.18.4",
    "oauth4webapi": "^3.1.4",
    "@equstng/agent-sdk": "../../../../wrappers/nodejs"
  },
  "devDependencies": {
    "jwt-decode": "^4.0.0",
    "@types/base-64": "^1.0.2",
    "@types/jest": "^29.5.13",
    "@types/node-jose": "^1.1.13",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "base-64": "^1.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "mockttp": "^3.15.3",
    "node-jose": "^2.2.0",
    "prettier": "^3.2.5",
    "reflect-metadata": "^0.2.1",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  }
}
