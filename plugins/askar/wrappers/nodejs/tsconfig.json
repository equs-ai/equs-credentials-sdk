{
  "compilerOptions": {
    "lib": [
      "ESNext"
    ],
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "emitDeclarationOnly": false,
    "target": "ESNext",
    "outDir": ".",
    "baseUrl": "./"
  },
  "include": [
    "index.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}