{
  "name": "agent-sdk",
  "version": "0.5.0",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "agent-sdk",
    "triples": {}
  },
  "license": "MIT",
  "ava": {
    "timeout": "3m"
  },
  "engines": {
    "node": ">= 10"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release && node scripts/fix-type-names.mjs && node scripts/add-import-line.mjs",
    "build:debug": "napi build --features=in-memory --platform && node scripts/fix-type-names.mjs && node scripts/add-import-line.mjs",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "jest -w=1",
    "universal": "napi universal",
    "version": "napi version",
    "postinstall": "if [ \"$NODE_ENV\" = \"development\" ]; then npm run build:debug; else npm run build; fi"
  },
  "packageManager": "yarn@4.5.0",
  "dependencies": {
    "jwt-decode": "^4.0.0",
    "oauth4webapi": "^3.1.4"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4",
    "@types/base-64": "^1.0.2",
    "@types/jest": "^29.5.13",
    "@types/node-jose": "^1.1.13",
    "@typescript-eslint/eslint-plugin": "^7.4.0",
    "@typescript-eslint/parser": "^7.4.0",
    "base-64": "^1.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "mockttp": "^3.15.3",
    "node-jose": "^2.2.0",
    "prettier": "^3.2.5",
    "reflect-metadata": "^0.2.1",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  }
}
