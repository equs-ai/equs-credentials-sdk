{
  "name": "agent-sdk",
  "version": "0.2.3",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "agent-sdk",
    "triples": {}
  },
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4",
    "ava": "^6.0.1",
    "mockttp": "^3.15.3",
    "node-jose": "^2.2.0"
  },
  "ava": {
    "timeout": "3m"
  },
  "engines": {
    "node": ">= 10"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release && node fix-type-names.mjs",
    "build:debug": "napi build --features=in-memory --platform && node fix-type-names.mjs",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "ava",
    "universal": "napi universal",
    "version": "napi version",
    "postinstall": "if [ \"$NODE_ENV\" = \"development\" ]; then npm run build:debug; else npm run build; fi"
  },
  "packageManager": "yarn@4.5.0"
}
