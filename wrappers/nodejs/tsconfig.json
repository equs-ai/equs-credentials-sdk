{
  "compilerOptions": {
    "rootDir": ".",
    "declaration": true,
    "emitDeclarationOnly": false,
    "module": "commonjs",
    "lib": ["ESNext"],
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ESNext"
  },
  "include": ["index.ts"],
  "exclude": ["node_modules"]
}
