{
  "bail": false,
  "verbose": true,
  "moduleFileExtensions": ["js", "ts", "d.ts"],
  "preset": "ts-jest",
  "transform": {
    "^.+\\.(ts|tsx)$": [
      "ts-jest",
      {
        "tsconfig": "tsconfig.cjs.json"
      }
    ]
  },
  "testPathIgnorePatterns": ["/node_modules/", "/build/"],
  "modulePaths": ["<rootDir>/"],
  "setupFiles": [],
  "clearMocks": true,
  "collectCoverage": true,
  "rootDir": ".",
  "globals": {}
}
