{
  "bail": false,
  "verbose": true,
  "moduleFileExtensions": ["js", "ts", "d.ts"],
  "preset": "jest-puppeteer",
  "transform": {
    "^.+\\.(ts|tsx)$": "ts-jest"
  },
  "testPathIgnorePatterns": ["/node_modules/", "/build/"],
  "modulePaths": ["<rootDir>/"],
  "setupFiles": [],
  "clearMocks": true,
  "collectCoverage": true,
  "rootDir": ".",
  "globals": {}
}
