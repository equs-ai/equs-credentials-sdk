{
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": "./",
    "outDir": "pkg",
    "declaration": true,
    "emitDeclarationOnly": false,
    "module": "commonjs",
    "strict": false,
    "lib": [
      "ESNext",
      "dom"
    ],
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ESNext",
    "paths": {
      "./binary": [
        "./wrappers/wasm/pkg/binary"
      ],
      "./dist": [
        "./wrappers/wasm/pkg/dist"
      ]
    }
  },
  "include": [
    "index.ts"
  ],
  "exclude": [
    "node_modules",
    "test"
  ]
}
